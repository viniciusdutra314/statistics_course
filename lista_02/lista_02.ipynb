    "using CairoMakie\n",
    "\n",
    "fig = Figure(size = (700, 450))\n",
    "ax = Axis(\n",
    "    fig[1, 1],\n",
    "    xlabel = \"x\",\n",
    "    ylabel = \"sin(x)\",\n",
    ")\n",
    "\n",
    "x = range(0, 2π; length = 200)\n",
    "lines!(ax, x, sin.(x))\n"
